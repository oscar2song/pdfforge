#!/usr/bin/env bash
# Cross-platform git hook dispatcher — prefers PowerShell when available
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File "$HOOK_DIR/../scripts/pre_commit.ps1"
  exit $?
elif command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -ExecutionPolicy Bypass -File "$HOOK_DIR/../scripts/pre_commit.ps1"
  exit $LASTEXITCODE
else
  bash "$HOOK_DIR/../scripts/pre_commit.sh"
  exit $?
fi
