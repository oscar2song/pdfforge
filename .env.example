# PDFForge (.env.example)
# Copy to .env and adjust values for your environment

# Flask
FLASK_ENV=production
SECRET_KEY=change-me
PORT=8080

# Storage (inside container or local path when running without Docker)
UPLOAD_FOLDER=./uploads

# Logging
LOG_LEVEL=INFO
LOG_FILE=pdfforge.log

# Premium SaaS integration (client)
PREMIUM_ENABLED=true
PREMIUM_BASE_URL=http://localhost:5003
PREMIUM_API_KEY=dev-123456
PREMIUM_TIMEOUT_SECONDS=60
PREMIUM_RETRIES=0
PREMIUM_DOWNLOAD_PROXY=true

# OCR (optional for future features)
# TESSERACT_CMD=/usr/bin/tesseract
